---
import generalData from '../content/data.json';
import projectData from '../content/projets.json';
import Nav from '../components/Nav.astro';
import Section from '../components/Section.astro';
import Footer from '../components/Footer.astro';
const { hero = {}, about = {}, contact = {}, footer = {} } = generalData;
const { projects = [] } = projectData;
---
<html lang="fr" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{hero.title || 'CALL Learning — Portfolio'}</title>
    <meta name="description" content="CALL Learning — Expertise technique LMS Open Source. Portfolio & projets." />
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#4f46e5" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  </head>
  <body>
    <Nav />

    <div class="header-logo-full">
      <div class="header-logo-full-bg">
        <img src="/images/logo.png" alt="CALL Learning Logo" class="logo" />
        <div class="header-logo-full-title">
          <div>{hero.generaltitle}</div>
          <div class="header-logo-full-subtitle">{hero.generalsubtitle}</div>
        </div>

      </div>
    </div>

    <header class="hero hero-full">
      <div class="hero-center" style="width:100vw; display:flex; flex-direction:column; align-items:center; justify-content:center;">
        <div style="max-width:700px; width:100%; text-align:center;">
          <h1>{hero.title || hero.name || 'CALL Learning <dot> IO'}</h1>
          {hero.subtitle && <p class="lead">{hero.subtitle}</p>}
          <div style="display:flex; gap:.75rem; flex-wrap:wrap; justify-content:center;">
            <a class="btn primary" href={hero.cta?.url || '#contact'}>{hero.cta?.label || 'Contact'}</a>
            <a class="btn secondary" href="#projects">Voir les projets</a>
          </div>
        </div>
      </div>
    </header>

    <Section id="about" title="À propos">
      <div class="about-inner">
        <div class="about-text">
          {about.description && <p set:html={about.description} />}
        </div>

        {about.img && (
          <img
            src={`/images/${about.img}`}
            alt="Logo"
            class="about-img"
          />
        )}
      </div>
    </Section>

    <Section id="projects" title="Nos projets">
      {projects.length === 0 ? <p class="muted">Aucun projet pour le moment.</p> : (
        <div class="grid">
          {projects.map((p) => (
            <article class="card">
              {p.img && <img src={`/images/${p.img}`} alt={p.title || 'Projet'} loading="lazy" />}
              <div class="inner">
                <h3>{p.title}</h3>
                {p.info && <p>{p.info}</p>}
                {p.info2 && <p class="muted">{p.info2}</p>}
                <div class="actions">
                  {p.url && <a class="btn primary" href={p.url} target="_blank" rel="noopener">Site</a>}
                  {p.repo && <a class="btn secondary" href={p.repo} target="_blank" rel="noopener">Code Source</a>}
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </Section>

    <Section id="contact" title="Contact">
      <div class="contact-block">
        <div class="contact-logo">
          <img src="/images/logo.png" alt="CALL Learning Logo" />
        </div>
        <p class="contact-lead">Envie d'échanger sur un projet, une idée ou simplement en savoir plus&nbsp;? Nous répondrons rapidement&nbsp;!</p>
        <div class="contact-links">
          <a href="mailto:{contact.email}" class="contact-link"><i class="fa-solid fa-envelope"/>{contact.email}</a>
        </div>
      </div>
    </Section>

    <Footer {...footer} />
  </body>
</html>
