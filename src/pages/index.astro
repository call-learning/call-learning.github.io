---
import data from '../content/data.json';
import Nav from '../components/Nav.astro';
import Section from '../components/Section.astro';
import Footer from '../components/Footer.astro';
const { hero = {}, about = {}, projects = [], contact = {}, footer = {} } = data;
---
<html lang="fr" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{hero.title || 'CALL Learning — Portfolio'}</title>
    <meta name="description" content="CALL Learning — Expertise technique LMS Open Source. Portfolio & projets." />
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#4f46e5" />
  </head>
  <body>
    <Nav />

    <div class="header-logo-full">
      <div class="header-logo-full-bg">
        <img src="/images/logo.png" alt="CALL Learning Logo" class="header-logo-full-img" />
        <div class="header-logo-full-title">
          <div>{hero.generaltitle}</div>
          <div class="header-logo-full-subtitle">{hero.generalsubtitle}</div>
        </div>

      </div>
    </div>

    <header class="hero">
      <div class="container" style="display:grid; grid-template-columns: 1.2fr .8fr; gap:2rem; align-items:center;">
        <div>
          <h1>{hero.title || hero.name || 'CALL Learning <dot> IO'}</h1>
          {hero.subtitle && <p class="lead">{hero.subtitle}</p>}
          <div style="display:flex; gap:.75rem; flex-wrap:wrap">
            <a class="btn primary" href={hero.cta?.url || '#contact'}>{hero.cta?.label || 'Contact'}</a>
            <a class="btn secondary" href="#projects">Voir les projets</a>
          </div>
        </div>
        {about.img && <img src={`/images/${about.img}`} alt="Mascotte" class="doggo" />}
      </div>
    </header>

    <Section id="about" title="À propos">
      {about.description && <p set:html={about.description} />}
    </Section>

    <Section id="projects" title="Nos projets">
      {projects.length === 0 ? <p class="muted">Aucun projet pour le moment.</p> : (
        <div class="grid">
          {projects.map((p) => (
            <article class="card">
              {p.img && <img src={`/images/${p.img}`} alt={p.title || 'Projet'} loading="lazy" />}
              <div class="inner">
                <h3>{p.title}</h3>
                {p.info && <p>{p.info}</p>}
                {p.info2 && <p class="muted">{p.info2}</p>}
                <div class="actions">
                  {p.url && <a class="btn primary" href={p.url} target="_blank" rel="noopener">Site</a>}
                  {p.repo && <a class="btn secondary" href={p.repo} target="_blank" rel="noopener">Code Source</a>}
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </Section>

    <Section id="contact" title="Contact">
      <div class="contact-block">
        <div class="contact-logo">
          <img src="/images/logo.png" alt="CALL Learning Logo" />
        </div>
        <p class="contact-lead">Envie d'échanger sur un projet, une idée ou simplement en savoir plus&nbsp;? Nous répondrons rapidement&nbsp;!</p>
        <div style="display:flex; justify-content:center; margin:2rem 0;">
          <a class="btn primary contact-btn" href="mailto:contact@call-learning.io">Envoyer un email</a>
        </div>
        <div class="contact-links">
          <a href="mailto:contact@call-learning.io" class="contact-link"><svg width="20" height="20" fill="none" viewBox="0 0 24 24"><path stroke="#6366f1" stroke-width="2" d="M4 4h16v16H4V4zm0 0l8 8 8-8"/></svg> contact@call-learning.io</a>
          <a href="https://www.linkedin.com/in/laurentd" target="_blank" rel="noopener" class="contact-link"><svg width="20" height="20" fill="none" viewBox="0 0 24 24"><path stroke="#6366f1" stroke-width="2" d="M16 8a6 6 0 0 1 6 6v6h-4v-6a2 2 0 0 0-4 0v6h-4v-6a6 6 0 0 1 6-6z"/><circle cx="6" cy="6" r="3" stroke="#6366f1" stroke-width="2"/></svg> LinkedIn</a>
        </div>
      </div>
    </Section>

    <Footer {...footer} />
  </body>
</html>
