---
const networks = Astro.props.networks || [];
const address = Astro.props.address || "";
const phone = Astro.props.phone || "";
const email = Astro.props.email || "";
const siret = Astro.props.siret || "";

const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container dflex">
    <div class="dflex dflex-wrap">
    {address && (
      <p><i class="fa-solid fa-house"></i>{address}</p>
    )}
    {phone && (
      <p><i class="fa-solid fa-phone"></i> Téléphone&nbsp;: {phone}</p>
    )}
    {email && (
      <p><i class="fa-solid fa-envelope"></i> Email&nbsp;: {email}</p>
    )}
    {siret && (
      <p><i class="fa-solid fa-id-card"></i> SIRET&nbsp;: {siret}</p>
    )}
    {networks.length > 0 && (
      <p>
        {networks.map((n) => (
          <a class="badge" href={n.url} target="_blank" rel="noopener">{n.name}</a>
        ))}
      </p>
    )}
    </div>
    <p class="muted">© {year} CALL Learning</p>
  </div>
</footer>
<style>
.footer { border-top:1px solid rgba(0,0,0,.06); padding: 2rem 0; }
.badge { display:inline-flex; align-items:center; gap:.4rem; padding:.25rem .6rem; border-radius:.6rem; background: rgba(14,165,163,.15); color: #0f172a; font-size:.85rem; text-decoration:none; }
.muted { color: #6b7280; display: block; margin-top: 1rem; font-size: .9rem; }
.footer i { margin-right: .5em; color: #6366f1; font-size: 1.1em; vertical-align: middle; }
</style>
