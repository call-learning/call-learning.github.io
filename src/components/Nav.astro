---
const links = [
  { href: "/#about", label: "À propos" },
  { href: "/#projects", label: "Projets" },
  { href: "/engagements", label: "Nos Engagements" },
  { href: "/equipe", label: "L’équipe" },
  { href: "/#contact", label: "Contact" },
];
---
<nav class="navbar">
  <div class="inner container">
    <a href="#top" class="logo">CALL Learning</a>

    <!-- Hamburger button -->
    <button class="menu-toggle" aria-label="Menu">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <ul class="nav-links">
      <li><a href="/#about">À propos</a></li>
      <li><a href="/#projects">Projets</a></li>
      <li><a href="/engagements">Nos Engagements</a></li>
      <li><a href="/equipe">L’équipe</a></li>
      <li><a href="/#contact">Contact</a></li>
    </ul>
  </div>
</nav>

<script>
  document.querySelector(".menu-toggle").onclick = () => {
    document.querySelector(".nav-links").classList.toggle("open");
  };
</script>
<style>
.navbar {
  position: sticky;
  top: 0;
  backdrop-filter: blur(6px);
  background: rgba(255, 255, 255, 0.6);
  border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  z-index: 50;
}

/* base layout */
.navbar .inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.6rem 1.25rem;
}

.navbar a.logo {
  font-weight: 800;
  letter-spacing: 0.3px;
  text-decoration: none;
  color: #0f172a;
}

/* nav links */
.navbar .nav-links {
  list-style: none;
  display: flex;
  gap: 1rem;
  margin: 0;
  padding: 0;
}

.navbar .nav-links a {
  color: #0f172a;
  text-decoration: none;
  padding: 0.35rem 0.6rem;
  border-radius: 0.6rem;
}

.navbar .nav-links a:hover {
  background: rgba(0, 0, 0, 0.05);
}

/* hamburger button */
.menu-toggle {
  display: none; /* hidden on desktop */
  border: none;
  background: transparent;
  cursor: pointer;
  padding: 0.25rem;
  margin-left: 1rem;
}

.menu-toggle span {
  display: block;
  width: 22px;
  height: 2px;
  margin: 4px 0;
  background: #0f172a;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

/* MOBILE styles */
@media (max-width: 768px) {
  .navbar .inner {
    align-items: center;
  }

  /* show hamburger, hide links by default */
  .menu-toggle {
    display: block;
  }

  .navbar .nav-links {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    padding: 0.75rem 1.25rem 1rem;
    gap: 0.5rem;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-4px);
    transition:
      max-height 0.2s ease,
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .navbar .nav-links.open {
    max-height: 400px; /* big enough for all items */
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .navbar .nav-links li a {
    display: block;
    width: 100%;
  }
}

/* optional: animate hamburger to "X" when open */
@media (max-width: 768px) {
  .nav-links.open ~ .menu-toggle span:nth-child(1),
  .navbar.open .menu-toggle span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .nav-links.open ~ .menu-toggle span:nth-child(2),
  .navbar.open .menu-toggle span:nth-child(2) {
    opacity: 0;
  }

  .nav-links.open ~ .menu-toggle span:nth-child(3),
  .navbar.open .menu-toggle span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }
}
</style>
